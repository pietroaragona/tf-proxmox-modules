# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Ansible, Kubernetes, Helm, CI
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Terraform / OpenTofu (formato di `terraform fmt`)
[*.{tf,tfvars,hcl}]
indent_style = space
indent_size = 2

# Go (gofmt usa tab)
[*.go]
indent_style = tab

[go.{mod,sum}]
indent_style = tab

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# Template Jinja2: mantengono lo stile del file di destinazione
[*.j2]
indent_style = space
indent_size = 2

# Markdown: due spazi a fine riga sono un a capo
[*.md]
trim_trailing_whitespace = false

# Script Windows
[*.{bat,cmd,ps1}]
end_of_line = crlf
